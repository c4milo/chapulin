invariant: INV-13
file: handshake.c
catches: unit
reason: ch_connect fails a first ClientHello too long for ch_tls.tx with
  an internal_error alert in the clear and CH_ECAP, where ch_record_init
  and ch_quic_init refuse the same hello with CH_EINVAL and send nothing.
  The hello is built before the first byte goes out, so every client
  entry owes a refusal on entry for it. bin/unit gives ch_connect a PSK
  identity as long as ch_tls.tx and requires CH_EINVAL, no send and no
  alert recorded.

--- old
    if (hello_len == 0) {
        ct_wipe(&h, sizeof h);
        t->state = CH_ST_FAILED;
        return CH_EINVAL;
    }
--- new
    if (hello_len == 0) {
        ct_wipe(&h, sizeof h);
        tlsi_fail(t, ALERT_INTERNAL_ERROR);
        return CH_ECAP;
    }
