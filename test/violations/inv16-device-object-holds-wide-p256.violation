invariant: INV-16
file: Makefile
catches: test/lint-trust-separation.sh
reason: every object that carries P-256 carries the wide files, a device
  object among them. The files compile to nothing there, so nothing fails,
  and a later change that calls their entries would run the 64x64->128
  multiply where no session states its timing. lint-trust-separation's
  P-256 rows ban the five files from every device object's source list.

--- old
ifneq ($(CPU_RUNTIME_DEF),)
LIB_SRCS += $(if $(filter p256_point.c,$(LIB_SRCS)),$(P256_WIDE_SRCS))
endif
--- new
LIB_SRCS += $(if $(filter p256_point.c,$(LIB_SRCS)),$(P256_WIDE_SRCS))
