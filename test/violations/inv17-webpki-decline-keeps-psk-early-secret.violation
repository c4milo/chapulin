invariant: INV-17
file: handshake_flight.c
catches: webpki_resume_test
reason: a TRUST=webpki client that falls back to a full handshake keeps
  the PSK's early secret and binder key instead of wiping them, and its
  key schedule starts from the PSK a server declined. The mock server,
  which derived its keys from the early secret of no PSK, and the
  handler row that reads h.early and h.binder_key both object.

--- old
    ct_wipe(h->early, sizeof h->early);
    ct_wipe(h->binder_key, sizeof h->binder_key);
    early_secret_without_psk(h->early);
    return CH_OK;
}
--- new
    return CH_OK;
}
