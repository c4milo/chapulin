invariant: INV-16
file: srv_auth.c
catches: tcp_blocking_loop_host
reason: the server signs with its RSA key under WIDEMUL_NOT_STATED whatever
  its ch_cfg.cpu states. The signature is the same. The blocking loop's
  server holds the RSA identity alone, and
  test/tcp_blocking_loop_widemul.h requires a handshake between two ends
  whose ch_cfg.cpu holds CH_CPU_CONSTANT_TIME_MULTIPLY to call no file
  under its own names.

--- old
    int signed_ok = widemul_rsa_pss_sign_cpu(CH_CFG_CPU(*cfg), widemul_answer(cfg), id->priv,
--- new
    int signed_ok = widemul_rsa_pss_sign_cpu(CH_CFG_CPU(*cfg), WIDEMUL_NOT_STATED, id->priv,
