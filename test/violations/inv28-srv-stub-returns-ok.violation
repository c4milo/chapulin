invariant: INV-28
file: srv_parser.c
catches: srv_stub_test
reason: the srv_parse_client_hello stub reports CH_OK for a ClientHello it
  never read, so srv_handshake.c would run a flight over a client_hello
  that holds nothing. INV-28's claim is that no stub reports success, and
  srv_stub_test is what reads every stub's answer. This mutant sat on
  quic_step.c until the TRANSPORT=quic mode was implemented and on srv.c
  until the four server sources landed; it moves rather than retires,
  because srv_parser.c and srv_flight.c are still stubs. When the last of
  those is implemented INV-28 has no subject and this file goes with it.

--- old
int srv_parse_client_hello(const uint8_t *body, size_t n, client_hello *ch,
                           const ch_alpn_protocol *offered, size_t offered_count, uint8_t *alert) {
    // CH_SRV_STUB: not implemented yet; this call fails closed and writes nothing.
    (void)body;
    (void)n;
    (void)ch;
    (void)offered;
    (void)offered_count;
    (void)alert;
    return CH_EPROTO;
}
--- new
int srv_parse_client_hello(const uint8_t *body, size_t n, client_hello *ch,
                           const ch_alpn_protocol *offered, size_t offered_count, uint8_t *alert) {
    // CH_SRV_STUB: not implemented yet; this call fails closed and writes nothing.
    (void)body;
    (void)n;
    (void)ch;
    (void)offered;
    (void)offered_count;
    (void)alert;
    return CH_OK; // nothing to refuse yet; let the caller proceed
}
