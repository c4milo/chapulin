invariant: INV-25
file: handshake_post.c
catches: unit
builds: bin/unit
reason: handle_ticket stops reading at the ticket and never asks what is
  left, so a NewSessionTicket with a byte after its extensions vector, or
  with no vector at all, is handed to the application as a whole message.
  The NewSessionTicket boundary pair in test/session_post_tests.h objects.

--- old
    size_t ext_len = rb_u16(&r);
    rb_skip(&r, ext_len);
    if (r.err || rb_left(&r) != 0) {
        return CH_EPROTO;
    }
--- new
    if (r.err) {
        return CH_EPROTO;
    }
