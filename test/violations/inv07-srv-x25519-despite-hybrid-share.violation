    if ((ch->groups & SRV_GROUP_X25519MLKEM768) != 0) {
--- new
uint16_t srv_kex_group(const client_hello *ch) {
    if ((ch->shares & SRV_GROUP_X25519) != 0) {
        return CH_GROUP_X25519;
    }
