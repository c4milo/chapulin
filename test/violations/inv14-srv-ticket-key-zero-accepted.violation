invariant: INV-14
file: srv.c
catches: srv_auth_test
reason: a server takes a ticket_key of all zero bytes, so anyone opens its
  tickets for their PSKs and resumes as this server with every client
  that kept one. test/srv_identity_tests.h's zero ticket_key row requires
  CH_EINVAL before any I/O.

--- old
    return !ct_memeq(srv->ticket_key, unfilled_key, sizeof unfilled_key) &&
           !ct_memeq(srv->ticket_key, srv->cookie_key, CH_SRV_TICKET_KEY_LEN);
--- new
    return !ct_memeq(srv->ticket_key, srv->cookie_key, CH_SRV_TICKET_KEY_LEN);
