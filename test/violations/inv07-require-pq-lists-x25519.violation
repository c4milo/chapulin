invariant: INV-7
file: src/handshake_message.c
catches: webpki_session_test
reason: require_pq keeps x25519 in supported_groups, so the hello tells a
  server this client would accept a classic exchange it will then refuse.
  docs/decisions.md entry 53 says the flag makes the hello the one-group
  hello a raw KEX=pq build sends.

--- old
    size_t groups_len = cfg->require_pq ? 2 : 6;
    wb_u16(w, EXT_SUPPORTED_GROUPS);
    wb_u16(w, (uint16_t)(2 + groups_len));
    wb_u16(w, (uint16_t)groups_len);
    wb_u16(w, CH_GROUP_X25519MLKEM768);
    if (!cfg->require_pq) {
        wb_u16(w, CH_GROUP_X25519);
        wb_u16(w, CH_GROUP_SECP256R1);
    }
--- new
    size_t groups_len = cfg->require_pq ? 4 : 6;
    wb_u16(w, EXT_SUPPORTED_GROUPS);
    wb_u16(w, (uint16_t)(2 + groups_len));
    wb_u16(w, (uint16_t)groups_len);
    wb_u16(w, CH_GROUP_X25519MLKEM768);
    wb_u16(w, CH_GROUP_X25519);
    if (!cfg->require_pq) {
        wb_u16(w, CH_GROUP_SECP256R1);
    }
