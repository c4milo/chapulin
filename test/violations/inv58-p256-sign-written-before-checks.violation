invariant: INV-58
file: src/p256_sign.c
catches: p256_sign_fault_test
reason: write_if_checked copies the signature to sig before it reads the
  checks' verdict, so a signature that failed a check is in the caller's
  buffer when the call returns 0. A caller that ignores the return value
  sends it. bin/p256_sign_fault_test requires every byte of sig as it was
  after each refused fault.

--- old
    CT_DECLASSIFY(&checked, sizeof checked);
    if (checked == 0) {
        return 0;
    }
    CT_DECLASSIFY(r, P256_SCALAR_LEN);
    CT_DECLASSIFY(s, P256_SCALAR_LEN);
#ifdef CH_JWS
    // JWS's ES256 carries r then s at their full width, with no DER (RFC
    // 7518 section 3.4). The pair passed both checks, as the DER pair
    // below did.
    if (form == SIGNATURE_R_THEN_S) {
        if (cap < 2 * P256_SCALAR_LEN) {
            return 0;
        }
        memcpy(sig, r, P256_SCALAR_LEN);
        memcpy(sig + P256_SCALAR_LEN, s, P256_SCALAR_LEN);
        *sig_len = 2 * P256_SCALAR_LEN;
        return 1;
    }
#else
    (void)form;
#endif
    uint8_t candidate[P256_SIG_MAX];
    size_t candidate_len = 0;
    // The array holds the longest signature, so write_signature never refuses.
    int rc =
        write_signature(candidate, sizeof candidate, &candidate_len, r, s) && candidate_len <= cap;
    if (rc) {
        memcpy(sig, candidate, candidate_len);
        *sig_len = candidate_len;
    }
    ct_wipe(candidate, sizeof candidate);
    return rc;
--- new
    (void)form;
    uint8_t candidate[P256_SIG_MAX];
    size_t candidate_len = 0;
    int rc =
        write_signature(candidate, sizeof candidate, &candidate_len, r, s) && candidate_len <= cap;
    if (rc) {
        memcpy(sig, candidate, candidate_len);
        *sig_len = candidate_len;
    }
    ct_wipe(candidate, sizeof candidate);
    CT_DECLASSIFY(&checked, sizeof checked);
    return rc && checked != 0;
