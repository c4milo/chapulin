invariant: INV-16
file: Makefile
catches: test/lint-trust-separation.sh
reason: a host object packages sha512_hw.c and sha512_avx2.c wherever it
  packages sha512.c, with or without SUITE=aesgcm. A TRUST=webpki object
  without the suite hashes certificates with sha512.c through calls that
  take no ch_cfg.cpu, so no call in it runs either file, and the object
  would hold SHA-512 instructions, or on x86-64 an AVX2 kernel, that
  nothing in it can run (docs/decisions.md 93 and 128). The lint reads
  each object's source list and refuses both files in a host object
  without the suite.

--- old
LIB_SRCS += $(filter-out $(if $(SUITE_DEF),,$(SHA512_HW_SRCS)),$(call hash_hw_of,$(LIB_SRCS)))
--- new
LIB_SRCS += $(call hash_hw_of,$(LIB_SRCS))
