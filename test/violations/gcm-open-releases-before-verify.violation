invariant: INV-26
file: gcm.c
catches: quic_test
builds: bin/quic_test
reason: gcm_open writes the plaintext before it compares the tag, so a
  packet with a wrong tag hands its decryption to the caller and the
  refusal arrives too late to matter. gcm.h promises the opposite in
  so many words, and aead.c has held the same order for ChaCha20-Poly1305
  since it was written. The vectors in test/gcm_tests.h check that a
  refused open leaves the output buffer as it was, so bin/quic_test is
  what objects.

--- old
    uint32_t ok = ct_memeq(want, tag, GCM_TAG);
    ct_wipe(want, sizeof want);
    if (!ok) {
        return 0;
    }
    uint8_t counter[AES_BLOCK];
    memcpy(counter, first_counter, AES_BLOCK);
    counter_mode(k, counter, ct, n, pt);
    return 1;
--- new
    uint8_t counter[AES_BLOCK];
    memcpy(counter, first_counter, AES_BLOCK);
    counter_mode(k, counter, ct, n, pt);
    uint32_t ok = ct_memeq(want, tag, GCM_TAG);
    ct_wipe(want, sizeof want);
    if (!ok) {
        return 0;
    }
    return 1;
