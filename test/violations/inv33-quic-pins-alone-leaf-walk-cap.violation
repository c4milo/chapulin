invariant: INV-33
file: webpki_cert.c
catches: quic_loop_webpki
reason: a TRANSPORT=quic-nonblocking build holds the leaf under pins
  alone to the walk's CH_WEBPKI_CERT_MAX, so a DNS-over-QUIC client
  refuses a leaf over 3072 bytes that its DNS-over-TLS twin takes, such
  as the QUIC Interop Runner's 5,514-byte amplificationlimit leaf. The
  TCP tests pass on this edit; test/quic_loop_pins.h's
  leaf_over_cert_max row against this tree's QUIC server objects.

--- old
    if (!read_certificate_head(cert, cert_len, CH_WEBPKI_LEAF_PIN_CERT_MAX, &r, out)) {
--- new
#ifdef CH_TRANSPORT_QUIC_NONBLOCKING
    if (!read_certificate_head(cert, cert_len, CH_WEBPKI_CERT_MAX, &r, out)) {
#else
    if (!read_certificate_head(cert, cert_len, CH_WEBPKI_LEAF_PIN_CERT_MAX, &r, out)) {
#endif
