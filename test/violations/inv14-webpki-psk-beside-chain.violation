invariant: INV-14
file: webpki_ticket.c
catches: webpki_session_test
reason: a TRUST=webpki config may carry an external PSK, and a resumed
  handshake presents no certificate, so it skips the hostname check.
  bin/webpki_session_test's psk and psk_id rows object.
--- old
    return cfg->psk == NULL && cfg->psk_len == 0 && cfg->psk_id == NULL && cfg->psk_id_len == 0 &&
           cfg->ticket == NULL;
--- new
    (void)cfg;
    return 1;

