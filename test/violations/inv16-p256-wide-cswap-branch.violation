invariant: INV-16
file: p256_wide_field.c
catches: test/lint-wide-multiply.sh
reason: p256_wide_fe_cswap takes the mask of a secret scalar bit, and
  writing the exchange as an if on that mask puts the bit on the control
  path of every ladder round. The values stay right, so the vectors, the
  equivalence binary and the proofs all pass; only the count of what the
  compiler emits sees it. The pinned clang emits one more conditional
  branch for p256_wide_field.c on both 64-bit specs, 9 against the file's
  ceiling of 8.

--- old
    for (size_t i = 0; i < P256_WIDE_FE_LIMBS; i++) {
        uint64_t exchange = (a->limb[i] ^ b->limb[i]) & mask;
        a->limb[i] ^= exchange;
        b->limb[i] ^= exchange;
    }
--- new
    if (mask != 0) {
        for (size_t i = 0; i < P256_WIDE_FE_LIMBS; i++) {
            uint64_t held = a->limb[i];
            a->limb[i] = b->limb[i];
            b->limb[i] = held;
        }
    }
