invariant: INV-16
file: ct.h
catches: test/lint-wide-multiply.sh
reason: ct_widemul_s goes back to the unsigned product of the bit
  patterns with two corrections of its high word, each a mask of an
  operand's sign bit, where the routine now reads no sign bit by itself.
  The products stay right, so the vectors, the multiply test and the
  proofs all pass. In x25519's mul the first mask is the same for a whole
  row, and clang for x86-64 keeps the row's products in vector registers
  and picks between a word of b and zero with a jump on the sign of a
  word of a: x25519.c@host goes to 13 against its ceiling of 12 on the
  x86-64 spec. On the m3 spec the same mask is an IT block, and x25519.c
  goes to 34 against 33 (docs/decisions.md 125).

--- old
    uint32_t al = (uint32_t)a & 0xFFFFU;
    uint32_t ah = (uint32_t)(a >> 16);
    uint32_t bl = (uint32_t)b & 0xFFFFU;
    uint32_t bh = (uint32_t)(b >> 16);
    uint32_t ll = al * bl;
    uint32_t lh = al * bh;
    uint32_t hl = ah * bl;
    uint32_t hh = ah * bh;
    uint32_t t = hl + (ll >> 16);
    uint32_t w1 = (t & 0xFFFFU) + lh;
    uint32_t hi = hh + (uint32_t)((int32_t)t >> 16) + (uint32_t)((int32_t)w1 >> 16);
    uint32_t lo = (w1 << 16) | (ll & 0xFFFFU);
    return (int64_t)(((uint64_t)hi << 32) | lo);
--- new
    uint32_t ua = (uint32_t)a;
    uint32_t ub = (uint32_t)b;
    uint64_t p = ct_widemul(ua, ub);
    uint32_t ma = (uint32_t)(a >> 31);
    uint32_t mb = (uint32_t)(b >> 31);
    uint32_t hi = (uint32_t)(p >> 32) - (ub & ma) - (ua & mb);
    return (int64_t)(((uint64_t)hi << 32) | (uint32_t)p);
