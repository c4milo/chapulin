invariant: INV-28
file: tls.c
catches: test/lib-check-webpki-tcp-nonblocking.sh
reason: the webpki ch_connect loses the #ifndef CH_TRANSPORT_TCP_NONBLOCKING guard
  the pinned one carries, so a tcp-nonblocking object compiles the blocking
  connect call and imports the ch_handshake that handshake.c defines and
  this variant does not compile. INV-28 rests on that driver staying out
  of the object. The object still links and its export list does not
  move, because PUBLIC does not name ch_connect here and the link
  localizes it, so only a build that links this variant objects
  (https://github.com/c4milo/chapulin/issues/171).

--- old
// Guarded as the raw and ca ch_connect above is: this transport filters
// handshake.c out, so a compiled ch_connect leaves ch_handshake
// undefined.
#ifndef CH_TRANSPORT_TCP_NONBLOCKING
int ch_connect(ch_tls *t, const ch_cfg *cfg) {
    memset(t, 0, sizeof *t);
    t->cfg = *cfg;
    // A presented ticket becomes the session copy's PSK, which every rule
    // below reads (handshake_post.h).
    if (!hspost_present_ticket(&t->cfg) || !tlsi_config_ok(&t->cfg) || cfg->send == NULL ||
        cfg->recv == NULL) {
        t->state = CH_ST_FAILED;
        return CH_EINVAL;
    }
#ifdef CH_CPU_RUNTIME
    tlsi_record_cpu(t);
#endif
    t->now_seconds = cfg_clock_read(cfg); // the instant the chain walk judges at
    if (!webpki_clock_ok(cfg, t->now_seconds)) {
        t->state = CH_ST_FAILED;
        return CH_EINVAL;
    }
    // The hash every ticket this session receives is bound to. A session
    // without on_ticket gives no ticket to anyone, so it keeps the zeros
    // memset wrote and runs no hash here (webpki_ticket.h).
    t->takes_tickets = (uint8_t)webpki_takes_tickets(cfg);
    if (t->takes_tickets) {
        webpki_ticket_config_hash(CH_CFG_CPU(t->cfg), cfg, t->ticket_config_hash);
    }
    // psk_ok matters only to a CA build, so it is 0; tlsi_epoch_init
    // refuses the epoch callbacks, as it does in every build but a CA mode.
    int rc = tlsi_epoch_init(t, cfg, 0);
    if (rc != CH_OK) {
        t->state = CH_ST_FAILED;
        return rc;
    }
    return ch_handshake(t);
}
#endif // CH_TRANSPORT_TCP_NONBLOCKING
--- new
int ch_connect(ch_tls *t, const ch_cfg *cfg) {
    memset(t, 0, sizeof *t);
    t->cfg = *cfg;
    // A presented ticket becomes the session copy's PSK, which every rule
    // below reads (handshake_post.h).
    if (!hspost_present_ticket(&t->cfg) || !tlsi_config_ok(&t->cfg) || cfg->send == NULL ||
        cfg->recv == NULL) {
        t->state = CH_ST_FAILED;
        return CH_EINVAL;
    }
#ifdef CH_CPU_RUNTIME
    tlsi_record_cpu(t);
#endif
    t->now_seconds = cfg_clock_read(cfg); // the instant the chain walk judges at
    if (!webpki_clock_ok(cfg, t->now_seconds)) {
        t->state = CH_ST_FAILED;
        return CH_EINVAL;
    }
    // The hash every ticket this session receives is bound to. A session
    // without on_ticket gives no ticket to anyone, so it keeps the zeros
    // memset wrote and runs no hash here (webpki_ticket.h).
    t->takes_tickets = (uint8_t)webpki_takes_tickets(cfg);
    if (t->takes_tickets) {
        webpki_ticket_config_hash(CH_CFG_CPU(t->cfg), cfg, t->ticket_config_hash);
    }
    // psk_ok matters only to a CA build, so it is 0; tlsi_epoch_init
    // refuses the epoch callbacks, as it does in every build but a CA mode.
    int rc = tlsi_epoch_init(t, cfg, 0);
    if (rc != CH_OK) {
        t->state = CH_ST_FAILED;
        return rc;
    }
    return ch_handshake(t);
}
