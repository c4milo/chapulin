invariant: INV-5
file: src/pem_files.c
catches: pem_files_test
reason: the bundle call gives its writer one byte more than der_len, so
  a bundle one byte over the caller's DER room reads and its last byte
  lands past the room. test_bundle_room fills a room with one root and
  with two, and requires CH_EINVAL in a room one byte shorter.

--- old
    wb_init(&w, der, der_len);
    pem_blocks blocks;
    pem_blocks_init(&blocks, pem, pem_len);
    size_t count = 0;
    for (;;) {
        const uint8_t *cert = NULL;
        size_t cert_len = 0;
        int next = pem_blocks_next(&blocks, PEM_LABEL_CERTIFICATE, &w, &cert, &cert_len);
        if (next == PEM_BLOCKS_END) {
            break;
        }
        // The blocks share der's room, as a chain's do.
--- new
    wb_init(&w, der, der_len + 1);
    pem_blocks blocks;
    pem_blocks_init(&blocks, pem, pem_len);
    size_t count = 0;
    for (;;) {
        const uint8_t *cert = NULL;
        size_t cert_len = 0;
        int next = pem_blocks_next(&blocks, PEM_LABEL_CERTIFICATE, &w, &cert, &cert_len);
        if (next == PEM_BLOCKS_END) {
            break;
        }
        // The blocks share der's room, as a chain's do.
