invariant: INV-14
file: webpki_ticket.c
catches: webpki_session_test
reason: the TRUST=webpki PSK rule reads only the psk and psk_id
  pointers, so a config that sets psk_len or psk_id_len alone passes as
  a chain config, and a provisioning mistake that dropped a PSK goes
  unreported. bin/webpki_session_test's length-only rows object.

--- old
    return cfg->psk == NULL && cfg->psk_len == 0 && cfg->psk_id == NULL && cfg->psk_id_len == 0 &&
           cfg->resumption == 0 && cfg->ticket_binding == NULL;
--- new
    return cfg->psk == NULL && cfg->psk_id == NULL && cfg->resumption == 0 &&
           cfg->ticket_binding == NULL;
