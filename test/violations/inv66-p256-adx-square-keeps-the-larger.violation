invariant: INV-66
file: src/p256_adx_asm.h
catches: test/docker-aes-runtime-qemu.sh p256-adx
reason: p256_adx_sqr_mont's final subtraction keeps the value less p where
  the subtraction borrowed and the value where it did not, the choice
  inverted. A square then comes out at or above p, or wrapped below zero,
  for most inputs. bin/p256_adx_equiv_test compares each square with the
  model word for word, and the qemu lane runs it for x86-64.

--- old
        // The final subtraction of p.
        "mov %%r12, %%r8\n mov %%r13, %%r9\n mov %%r14, %%r10\n mov %%r15, %%r11\n"
        "mov $0xffffffff, %%eax\n"
        "sub $-1, %%r8\n sbb %%rax, %%r9\n sbb $0, %%r10\n sbb %%rbx, %%r11\n sbb $0, %%rcx\n"
        "cmovc %%r12, %%r8\n cmovc %%r13, %%r9\n cmovc %%r14, %%r10\n cmovc %%r15, %%r11\n"
--- new
        // The final subtraction of p.
        "mov %%r12, %%r8\n mov %%r13, %%r9\n mov %%r14, %%r10\n mov %%r15, %%r11\n"
        "mov $0xffffffff, %%eax\n"
        "sub $-1, %%r8\n sbb %%rax, %%r9\n sbb $0, %%r10\n sbb %%rbx, %%r11\n sbb $0, %%rcx\n"
        "cmovnc %%r12, %%r8\n cmovnc %%r13, %%r9\n cmovnc %%r14, %%r10\n cmovnc %%r15, %%r11\n"
