invariant: INV-41
file: src/rsa_mont64.c
catches: rsa_equiv_test_sum
reason: a round of rsa_mont64_mont_mul drops the running sum's top word,
  the bit above its k words, so a sum at or above 2^(64k) loses that bit
  and the product is wrong by a power of two. A modulus with its top bit
  set, the shape every key has, reaches that range.
  bin/rsa_equiv_test compares the bytes with the 32-bit arm's.

--- old
        t[k] = (uint64_t)(top >> 64);
    }
    reduce_once(o, t, t[k], m, k);
}

// The square of a is the sum over i of a_i B^i V_i, where B = 2^64 and
--- new
        t[k] = 0;
    }
    reduce_once(o, t, t[k], m, k);
}

