invariant: INV-5
file: Makefile
catches: test/lint-trust-separation.sh
reason: the raw-rsa arm stops filtering the PEM readers, so a raw client,
  which reads no certificate and decodes no file, packages pem.c,
  base64.c and x509_der.c. lint-trust-separation's raw-rsa row bans them.

--- old
PUBLIC_CA :=
TRUST_FILTER := $(PEM_READER_SRCS) src/x509.c src/x509_ca.c $(WEBPKI_SRCS)
PIN_FILTER := src/p256.c
--- new
PUBLIC_CA :=
TRUST_FILTER := src/x509.c src/x509_ca.c $(WEBPKI_SRCS)
PIN_FILTER := src/p256.c
