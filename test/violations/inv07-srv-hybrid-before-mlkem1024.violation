invariant: INV-7
file: srv_kex.c
catches: srv_flight_test
reason: the server asks about the hybrid before ML-KEM-1024, so a client
  that lists both, as a CNSA 2.0 client beside a general one may, gets
  X25519MLKEM768. docs/decisions.md 179 has the server select
  ML-KEM-1024 whenever the client lists it, and
  test_flight_select_mlkem1024 requires it for a hello that shares both.

--- old
    if ((ch->groups & SRV_GROUP_MLKEM1024) != 0) {
        return CH_GROUP_MLKEM1024;
    }
    if ((ch->groups & SRV_GROUP_X25519MLKEM768) != 0) {
        return CH_GROUP_X25519MLKEM768;
    }
--- new
    if ((ch->groups & SRV_GROUP_X25519MLKEM768) != 0) {
        return CH_GROUP_X25519MLKEM768;
    }
    if ((ch->groups & SRV_GROUP_MLKEM1024) != 0) {
        return CH_GROUP_MLKEM1024;
    }
