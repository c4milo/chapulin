invariant: INV-14
file: tcp_nonblocking.c
catches: webpki_loop_aes
reason: the webpki ch_record_init hashes the anchors whether or not the
  session takes tickets (docs/decisions.md 132). test/webpki_ticket_rows.h's
  row without on_ticket counts one hash where it requires none.

--- old
    r->t.takes_tickets = (uint8_t)webpki_takes_tickets(cfg);
    if (r->t.takes_tickets) {
        webpki_ticket_config_hash(CH_CFG_CPU(r->t.cfg), cfg, r->t.ticket_config_hash);
    }
--- new
    r->t.takes_tickets = (uint8_t)webpki_takes_tickets(cfg);
    webpki_ticket_config_hash(CH_CFG_CPU(r->t.cfg), cfg, r->t.ticket_config_hash);
