invariant: INV-16
file: Makefile
catches: test/lint-trust-separation.sh
reason: a host object stops carrying poly1305_vector_native.c, so
  poly1305_native.c's call to the vector path has no definition.
  lint-trust-separation's host rows require the file.

--- old
ifneq ($(CPU_RUNTIME_DEF),)
LIB_SRCS += poly1305_vector_native.c poly1305_avx2_native.c
endif
--- new
ifneq ($(CPU_RUNTIME_DEF),)
LIB_SRCS += poly1305_avx2_native.c
endif
