invariant: INV-16
file: p256_wide_field.c
catches: test/lint-invariants.sh
reason: p256_wide_fe_neg computes 0 - a word by word and adds p when it
  borrowed. The value is the same, so every vector, proof and count
  under clang passes. On the overflow builtins, gcc 13.3 for x86-64
  compiled each of the four borrows to a jump on a word of a at -O2, and
  a is the Y of the entry or of the multiple a digit named. gcc reads
  another form of the step by default, and a build that names the
  builtins reads this one. No check of this tree counts these files'
  branches under a 64-bit gcc, so the Semgrep rule
  inv-16-p256-wide-no-borrow-from-zero refuses the calls.

--- old
    uint64_t keep = ~p256_wide_fe_zero_mask(a);
    uint64_t borrow = 0;
    uint64_t d0 = p256_wide_sub_borrow(&borrow, ~a->word[0], ~P256_WIDE_P0);
    uint64_t d1 = p256_wide_sub_borrow(&borrow, ~a->word[1], ~P256_WIDE_P1);
    uint64_t d2 = p256_wide_sub_borrow(&borrow, ~a->word[2], ~P256_WIDE_P2);
    uint64_t d3 = p256_wide_sub_borrow(&borrow, ~a->word[3], ~P256_WIDE_P3);
    o->word[0] = d0 & keep;
    o->word[1] = d1 & keep;
    o->word[2] = d2 & keep;
    o->word[3] = d3 & keep;
--- new
    uint64_t borrow = 0;
    uint64_t d0 = p256_wide_sub_borrow(&borrow, 0, a->word[0]);
    uint64_t d1 = p256_wide_sub_borrow(&borrow, 0, a->word[1]);
    uint64_t d2 = p256_wide_sub_borrow(&borrow, 0, a->word[2]);
    uint64_t d3 = p256_wide_sub_borrow(&borrow, 0, a->word[3]);
    uint64_t wrapped = p256_wide_mask(borrow);
    uint64_t carry = 0;
    o->word[0] = p256_wide_add_carry(&carry, d0, P256_WIDE_P0 & wrapped);
    o->word[1] = p256_wide_add_carry(&carry, d1, P256_WIDE_P1 & wrapped);
    o->word[2] = p256_wide_add_carry(&carry, d2, P256_WIDE_P2 & wrapped);
    o->word[3] = p256_wide_add_carry(&carry, d3, P256_WIDE_P3 & wrapped);
