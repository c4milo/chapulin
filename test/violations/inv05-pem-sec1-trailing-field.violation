invariant: INV-5
file: x509_pem.c
catches: pem_files_test
reason: an ECPrivateKey may hold bytes after its curve or its public key,
  inside its SEQUENCE, and still read. RFC 5915 section 3 names no field
  there. test_key_fields writes a NULL after each and requires CH_EINVAL.

--- old
    if (bytes == NULL || !read_ec_optional(&r, curve_required, &xy) || r.err || rb_left(&r) != 0) {
--- new
    if (bytes == NULL || !read_ec_optional(&r, curve_required, &xy) || r.err) {
