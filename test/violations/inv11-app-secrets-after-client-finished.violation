invariant: INV-11
file: handshake_flight.c
catches: handshake_sequence_test
reason: the application traffic secrets snapshot the transcript after the client
  Finished instead of after the server Finished, so both directions key off
  the wrong RFC 9846 point. hsf_complete is where both transports derive
  them, so the mutant sits there rather than in one driver.

--- old
    uint8_t hash[SHA256_LEN];
    (void)hsr_transcript_hash(h, hash);
    ks_master(h->handshake_secret, hash, h->master, t->wr_secret, t->rd_secret);
    finished[0] = HS_FINISHED;
    finished[1] = 0;
    finished[2] = 0;
    finished[3] = SHA256_LEN;
    ks_verify_data(h->c_hs, hash, finished + 4);
    sha256_update(&t->transcript, finished, HSF_FINISHED_LEN);
    (void)hsr_transcript_hash(h, hash);
    ks_res_master(h->master, hash, t->res_master);
--- new
    uint8_t hash[SHA256_LEN];
    (void)hsr_transcript_hash(h, hash);
    finished[0] = HS_FINISHED;
    finished[1] = 0;
    finished[2] = 0;
    finished[3] = SHA256_LEN;
    ks_verify_data(h->c_hs, hash, finished + 4);
    sha256_update(&t->transcript, finished, HSF_FINISHED_LEN);
    (void)hsr_transcript_hash(h, hash);
    ks_master(h->handshake_secret, hash, h->master, t->wr_secret, t->rd_secret);
    ks_res_master(h->master, hash, t->res_master);
