invariant: INV-11
file: handshake.c
catches: hsseq_test
reason: the application traffic secrets snapshot the transcript after the client
  Finished instead of after the server Finished, so both directions key off
  the wrong RFC 9846 point

--- old
    // Server Finished is in; derive the application schedule, answer with
    // our Finished under the handshake keys, then switch both directions.
    (void)hsr_transcript_hash(h, hash);
    ks_master(h->handshake_secret, hash, h->master, t->wr_secret, t->rd_secret);
    rc = send_client_finished(h, hash);
    if (rc != CH_OK) {
        return rc;
    }
    (void)hsr_transcript_hash(h, hash);
    ks_res_master(h->master, hash, t->res_master);
--- new
    // Server Finished is in; answer with our Finished under the handshake
    // keys, then derive the whole application schedule in one place.
    (void)hsr_transcript_hash(h, hash);
    rc = send_client_finished(h, hash);
    if (rc != CH_OK) {
        return rc;
    }
    (void)hsr_transcript_hash(h, hash);
    ks_master(h->handshake_secret, hash, h->master, t->wr_secret, t->rd_secret);
    ks_res_master(h->master, hash, t->res_master);
