invariant: INV-25
file: handshake_parser.c
catches: handshake_strict_test
builds: bin/handshake_strict_test
reason: hsp_parse_encrypted_exts walks the message body instead of the
  extensions vector, so an extension the vector's length leaves out is
  still read and acted on. RFC 9846 §4.4.1 ends the message at the vector.
  test/handshake_strict_test.c's vector pair objects.

--- old
    size_t exts_len = rb_u16(&r);
    if (r.err || exts_len != rb_left(&r)) {
        return CH_EPROTO;
    }
    // bit 0 record_size_limit
--- new
    size_t exts_len = rb_u16(&r);
    (void)exts_len;
    if (r.err) {
        return CH_EPROTO;
    }
    // bit 0 record_size_limit
