invariant: INV-14
file: srv.c
catches: srv_tcp_nonblocking_test
reason: srv_config_ok stops asking srv_identities_usable, so a server
  starts a session with an identity its flight cannot sign with or send,
  and the flight fails after the ServerHello went out, where CH_EINVAL
  would say nothing was sent. The RSA modulus one byte past SRV_SIG_MAX
  is then taken at ch_srv_record_init, which
  test_init_refuses_an_rsa_modulus_past_the_buffer requires to refuse
  with nothing sent.

--- old
    return srv_identity_live(cfg) != 0 && srv_identities_usable(cfg) &&
           cfg->srv.cookie_key != NULL && sni_ok(&cfg->srv);
--- new
    return srv_identity_live(cfg) != 0 && cfg->srv.cookie_key != NULL && sni_ok(&cfg->srv);
