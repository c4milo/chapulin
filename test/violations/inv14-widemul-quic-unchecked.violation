invariant: INV-14
file: quic_config.c
catches: quic_loop_widemul
reason: quic_config_ok stops asking for the caller's answer about the widening
  multiply, so ch_quic_init and ch_srv_quic_init take a configuration that
  never stated it. test/quic_loop_widemul.h requires both to refuse 0
  and 3 with CH_EINVAL and a failed session.

--- old
#ifdef CH_WIDEMUL_RUNTIME
    // The caller's answer about the widening multiply (cpu_cfg.h).
    if (!widemul_answer_ok(cfg)) {
        return CH_EINVAL;
    }
#endif
--- new
