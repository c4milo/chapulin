invariant: INV-5
file: x509.c
catches: x509strict
reason: an unknown critical extension is accepted instead of rejected, so a
  CA constraint the client cannot interpret is silently ignored and
  the profile's grammar widens

--- old
    if (bit == 0) {
        // RFC 5280 §4.2: an unrecognized critical extension MUST be
        // rejected; unknown non-critical ones are skipped unread.
        if (!ext.critical) {
            return CH_OK;
        }
        *alert = ALERT_UNSUPPORTED_CERTIFICATE;
        return CH_EPROTO;
    }
--- new
    if (bit == 0) {
        // Unknown extensions carry nothing this profile reads, so skip
        // them whether or not the CA marked them critical.
        return CH_OK;
    }
