# Every tool version the checks depend on, in one place.
#
# The Makefile includes this file, the bench and test scripts source it, and
# .github/actions/load-pins appends its lines to every CI job's environment,
# so a development machine and a runner resolve the same versions from the
# same line. Before this file the pins lived only in
# .github/workflows/check.yml's env block, which meant they existed on CI and
# nowhere else: LLVM_MAJOR was referenced at Makefile:41 and never defined
# there, so a development machine linted with whatever clang-tidy it happened
# to carry. That is how a tree that passed CI failed `make check` locally
# under LLVM 23.
#
# The format is the intersection of `make include`, `sh .` and GITHUB_ENV
# syntax: NAME=value, no spaces around =, no quotes, no expansion. Keep it
# that way or one of the three readers stops working. `make lint-pins` fails
# if a workflow or a local action hardcodes a version this file already
# carries.
#
# Bumping a checker is not a routine update. CLAUDE.md forbids adapting code
# or suppressions to an older checker, so a new major reports what it reports
# and the findings are work to do, not noise to silence. The scheduled job in
# .github/workflows/toolchain-pins.yml opens a pull request when an upstream
# release appears and never merges it; the pull request's own CI run is the
# measurement of what the bump costs.

# Analysis tools. These decide what the linters say, not what the library
# does; none of them ships in bin/chapulin.o.
LLVM_MAJOR=23
CPPCHECK_VERSION=2.21.1
SHELLCHECK_VERSION=0.11.0

# Proof tools. Verdicts are solver-independent, so kissat is a speed pin
# rather than a correctness one, but proof/results/*.log record the CBMC
# version that produced them and the reach floors are measured under it.
CBMC_VERSION=6.11.0
KISSAT_VERSION=rel-4.0.4

# Workflow linting. actionlint reads the `run:` blocks the shell scripts'
# linter never sees: make lint-shellcheck covers bench/, proof/ and test/, and
# nothing covered the four workflow files until this. It caught a real defect --
# backticks inside a double-quoted echo, which the shell would have run as a
# command -- that make check could not.
#
# It stays out of `make check` on purpose. That target must not need a Go
# binary to build a C library, so this runs as a CI step instead. The checksum
# is the published one for the linux_amd64 tarball; the download is verified
# rather than trusted, which the CBMC, kissat, OpenSSL, cppcheck and shellcheck
# downloads in check.yml still are not.
ACTIONLINT_VERSION=1.7.12
ACTIONLINT_SHA256=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8

# The two install scripts CI executes, pinned by content. LLVM_MAJOR pins
# only the argument llvm.sh takes and elan-init.sh takes no version at all,
# so until this the scripts themselves ran unverified, llvm.sh as root
# (https://github.com/c4milo/chapulin/issues/87). Every job that runs one
# downloads it to a file, checks the file against the hash here with
# sha256sum -c, and only then executes it. Neither publisher signs the
# script or cuts releases of it, so both hashes are trust on first use, and
# .github/workflows/toolchain-pins.yml re-hashes each script weekly and
# proposes the new value when upstream serves a different file.
LLVM_SH_SHA256=03878e08f47b66cc95bc4b544b0db3c6d9ce8d60e6cf2492ae357984330a9eae
ELAN_INIT_SHA256=a620ff1641616222c8d37c54845492004bb84d6877cdbc944dd65c1aa685bf53

# Test-only dependencies. Both carry real CVEs upstream and neither is part
# of the library: OpenSSL backs test/e2e.sh's certificate recipes, and Go
# builds test/goecho. They are pinned because their behaviour moves — the
# runner's OpenSSL 3.0 predates the `x509 -req -not_before` flag docs/ca.md
# tells operators to use, and which curves Go offers by default changes
# between releases.
OPENSSL_VERSION=3.6.4
GO_VERSION=1.27.0

# Arm GNU toolchain for the Cortex-M3 test lane (test/qemu, m3-check).
# One release, two artifacts: CI's Linux x86_64 tarball and the
# development Macs' darwin package. The darwin sha256 is Homebrew's own
# pin for the same file; the Linux sha256 was recorded from the first
# verified download (trust on first use, like shellcheck's).
ARM_GNU_VERSION=15.3.rel1
ARM_GNU_LINUX_SHA256=563bebb2b97d53382b956d6ee1fe61e2cae26699901417234a37df505ef9b5fa
ARM_GNU_DARWIN_SHA256=5fb58dc3bd6684e70a02bd1c654a6b91f044cda241eb3ae663a7b9170491d7b2

# Bootlin riscv32 musl toolchain for the rv32 test lane: the publisher's
# own sha256, fetched from beside the tarball — a real pin, not trust on
# first use. The convenience prefix inside is riscv32-linux-. The
# instruction counts in bench/results-insn-rv32.csv are what this
# compiler emits, so a bump re-measures them in the same commit
# (bench/insn-rv32.sh).
RV32_TC_VERSION=stable-2025.08-1
RV32_TC_SHA256=f15e9ed67724b249eb149126eb6ed945648c3cdcd3c1c484b23c1a12df368391

# Container base for test/docker-riscv32.sh, the local mirror of the
# riscv32 CI job. The digest pins the image index; the lane's own
# toolchain pin above does the rest.
UBUNTU_DIGEST=sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517

# FreeRTOS kernel for the boot lane. Fetched by COMMIT, never by ref:
# this repository's Plus-TCP has a branch and a tag sharing one release
# name, and git clone --branch silently prefers the branch — a commit
# hash cannot be shadowed. The commit is tag V11.3.1's target.
FREERTOS_KERNEL_COMMIT=3a22924e0a9ddbbc8b0758881c33b3422a5cc20d
FREERTOS_PLUS_TCP_COMMIT=5986530664073a609e634bde63dd9bff37e725f0
